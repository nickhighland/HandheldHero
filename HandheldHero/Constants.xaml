<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FF00BFE7</Color>
    <Color x:Key="GlyphLightColor">#FF58E7F5</Color>
    <Color x:Key="SelectionLightColor">#FF73D8E5</Color>
    <Color x:Key="OverlayColor">#D9080D11</Color>
    
    <Color x:Key="ControlBackgroundColor">#FF18232A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0B1116</Color>

    <Color x:Key="TextColor">#FFF4F7F8</Color>
    <Color x:Key="TextColorDark">#FF89959B</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <!-- Interface accent (tabs, section titles, focus rings) -->
    <Color x:Key="AccentColor">#FF3FA2FF</Color>
    <Color x:Key="AccentSoftColor">#FF8CC8FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B2111A21" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#6648A7FF" />

    <!--
        AURORA TRACE settings (selection frame) - reference values.
        Colours, comet length (12 % of the perimeter) and the 3 s clockwise loop live in the "AuroraTrace"
        template in Media.xaml (regenerate with tools/build_aurora.py).
        The 1.04x selected-cover scale and 180 ms focus transition are written literally in
        DerivedStyles/ListGameItemStyle.xaml and Views/Main.xaml (Playnite parses each file on its own, so
        a StaticResource pointing at this file would stop the theme from loading).
        Frame: cool white #EAF6FF, 2.5 px at 1080p     Comet: #27CFFF > #965BFF > #FF48D0     Glow: ~8 px
    -->
    <sys:Double x:Key="AuroraSelectedScale">1.04</sys:Double>
    <Duration x:Key="AuroraFocusDuration">0:0:0.18</Duration>

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">250</sys:Double>
    
    <GridLength x:Key="ProgressWindowWidth">640</GridLength>
    
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebLight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.8" RadiusY="0.9">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF183C3C" Offset="0" />
            <GradientStop Color="#FF080D11" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1" >
        <GradientStop Color="#D40A1014" Offset="0"/>
        <GradientStop Color="#380A1014" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1" >
        <GradientStop Color="#380A1014" Offset="0"/>
        <GradientStop Color="#EA0A1014" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" >
        <GradientStop Color="#F0141C21" Offset="0"/>
        <GradientStop Color="#FF070B0E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0,0" EndPoint="1,1" >
        <GradientStop Color="{DynamicResource GlyphColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource GlyphLightColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.8" >
        <GradientStop Color="#0010181A" Offset="0.0"/>
        <GradientStop Color="#A8080D11" Offset="0.8"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />
</ResourceDictionary>
