<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!--
        The cover tile itself (used by the stock grid list AND by the RECENT / FAVORITES / MOST PLAYED carousel).
        Rounded corners come from a plain geometry clip sized to the tile (no brushes, masks or extra layers,
        so nothing can flash behind a cover while the list scrolls).
        Unselected covers stay quiet: a thin dark edge and no glow.
        Badges: gold star = favorite, green PLAYING = running now, download arrow = not installed.
    -->
    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid x:Name="TileRoot">
                        <Grid.Clip>
                            <RectangleGeometry RadiusX="10" RadiusY="10">
                                <RectangleGeometry.Rect>
                                    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="0, 0, [0], [1]">
                                        <Binding Path="ActualWidth" ElementName="TileRoot" />
                                        <Binding Path="ActualHeight" ElementName="TileRoot" />
                                    </MultiBinding>
                                </RectangleGeometry.Rect>
                            </RectangleGeometry>
                        </Grid.Clip>
                        <Image x:Name="PART_ImageCover"
                               RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Stretch="{Settings CoverArtStretch}" />
                        <Border Background="#AA000000" x:Name="BorderDarken" Visibility="Collapsed" />
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Settings Fullscreen.ShowGameTitles}"
                                   Style="{DynamicResource TextBlockBaseStyle}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                   TextAlignment="Center" Padding="5"
                                   Background="{DynamicResource ControlBackgroundDarkBrush}"/>

                        <!-- badges -->
                        <Border x:Name="BadgeFavorite" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,8,0" Padding="7,1,7,3" CornerRadius="11" Background="#CC081013"
                                IsHitTestVisible="False">
                            <TextBlock Text="&#x2605;" FontFamily="Segoe UI Symbol" FontSize="17" Foreground="#FFFFD451" />
                        </Border>
                        <Border x:Name="BadgeRunning" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" Padding="10,1,10,3" CornerRadius="11" Background="#E02FB04A"
                                IsHitTestVisible="False">
                            <TextBlock Text="PLAYING" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="15" Foreground="White" />
                        </Border>
                        <Border x:Name="BadgeNotInstalled" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" Padding="7,1,7,3" CornerRadius="11" Background="#CC081013"
                                IsHitTestVisible="False">
                            <TextBlock Text="&#x2B07;" FontFamily="Segoe UI Symbol" FontSize="17" Foreground="#FF8CC8FF" />
                        </Border>

                        <!-- thin dark edge for unselected covers -->
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#66000000" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="BadgeFavorite" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Visibility" Value="Visible" TargetName="BadgeNotInstalled" />
                        </DataTrigger>
                        <!-- declared last so "playing" wins over the not-installed arrow -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BadgeNotInstalled" />
                            <Setter Property="Visibility" Value="Visible" TargetName="BadgeRunning" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
