<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <BitmapImage x:Key="DefaultGameIcon" UriSource="{ThemeFile 'Images/applogo_clean.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DefaultGameCover" UriSource="{ThemeFile 'Images/custom_cover_background.png'}" popt:Freeze="True" />

    <TextBlock x:Key="BatteryStatusCritical" Text="&#xeeb1;" FontFamily="{StaticResource FontIcoFont}" />
    <TextBlock x:Key="BatteryStatusLow" Text="&#xeeb4;" FontFamily="{StaticResource FontIcoFont}" />
    <TextBlock x:Key="BatteryStatusMedium" Text="&#xeeb3;" FontFamily="{StaticResource FontIcoFont}" />
    <TextBlock x:Key="BatteryStatusHigh" Text="&#xeeb2;" FontFamily="{StaticResource FontIcoFont}" />
    <TextBlock x:Key="BatteryStatusCharging" Text="&#xeed4;" FontFamily="{StaticResource FontIcoFont}" />

    <Style x:Key="ProgressIndicator" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Fill="Transparent"
                    StrokeThickness="4"
                    Stroke="{DynamicResource ControlBackgroundBrush}"/>

                        <Ellipse HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Fill="Transparent" RenderTransformOrigin="0.5,0.5"
                    StrokeThickness="4"
                    Stroke="{DynamicResource GlyphBrush}">
                            <Ellipse.Resources>
                                <Storyboard x:Key="VisibleOn">
                                    <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(RotateTransform.Angle)"
                                        To="360" Duration="0:0:05" RepeatBehavior="Forever" />
                                </Storyboard>
                                <Storyboard x:Key="VisibleOff">
                                    <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(RotateTransform.Angle)"
                                        To="0" Duration="0:0:0"/>
                                </Storyboard>
                            </Ellipse.Resources>
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsVisible" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource VisibleOn}"/>
                                            </MultiTrigger.EnterActions>
                                            <MultiTrigger.ExitActions>
                                                <BeginStoryboard Storyboard="{StaticResource VisibleOff}"/>
                                            </MultiTrigger.ExitActions>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Clip>
                                <RectangleGeometry Rect="0,0,10,20"/>
                            </Ellipse.Clip>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProgressHeaderStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Image RenderOptions.BitmapScalingMode="Fant"
                       Stretch="Uniform"
                       MaxHeight="200"
                       Source="{ThemeFile 'Images/applogo_clean.png'}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<!--
        AURORA TRACE - selection frame for game covers.
        Thin cool-white frame + a short neon comet (white-hot head, blue > violet > magenta tail) that travels
        clockwise around the rounded perimeter once every 3 seconds, fading in over 180 ms.
        No pixel-shader effects: the glow is layered low-opacity strokes (shader effects on animated content
        flicker on some GPUs). The visuals only exist while the owning ListBoxItem is selected.
        Drawn in a fixed 300x400 design box stretched over the cover; tools/build_aurora.py regenerates this block.
    -->
    <ControlTemplate x:Key="AuroraTraceTemplate" TargetType="ContentControl">
        <Viewbox x:Name="AuroraRoot" Stretch="Fill" Opacity="0">
            <Grid Width="300" Height="400">
                <!-- stationary soft white halo around the whole cover -->
                <Rectangle Margin="-4.5" RadiusX="16" RadiusY="16" Stroke="#EAF6FF" StrokeThickness="12" Opacity="0.07" />
                <Rectangle Margin="-2" RadiusX="16" RadiusY="16" Stroke="#EAF6FF" StrokeThickness="7" Opacity="0.16" />
                <!-- the frame itself -->
                <Rectangle RadiusX="16" RadiusY="16" Stroke="#EAF6FF" StrokeThickness="3" Opacity="0.95" />
                <!-- inner-edge reflection: light passing through a thin glass frame -->
                <Rectangle Margin="3.5" RadiusX="13" RadiusY="13" Stroke="#66FFFFFF" StrokeThickness="1" />
                <!-- travelling comet: glow layer, then core layer -->
                <Grid>
                    <Rectangle x:Name="Glow0" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#FFFFFF" Opacity="0.28" StrokeDashArray="1.649 122.036" StrokeDashOffset="0.000" />
                    <Rectangle x:Name="Glow1" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#DDF7FF" Opacity="0.28" StrokeDashArray="1.649 122.036" StrokeDashOffset="1.649" />
                    <Rectangle x:Name="Glow2" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#86E3FF" Opacity="0.28" StrokeDashArray="1.649 122.036" StrokeDashOffset="3.298" />
                    <Rectangle x:Name="Glow3" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#27CFFF" Opacity="0.28" StrokeDashArray="1.649 122.036" StrokeDashOffset="4.947" />
                    <Rectangle x:Name="Glow4" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#4F8DFF" Opacity="0.28" StrokeDashArray="1.649 122.036" StrokeDashOffset="6.597" />
                    <Rectangle x:Name="Glow5" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#965BFF" Opacity="0.274" StrokeDashArray="1.649 122.036" StrokeDashOffset="8.246" />
                    <Rectangle x:Name="Glow6" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#C255F0" Opacity="0.252" StrokeDashArray="1.649 122.036" StrokeDashOffset="9.895" />
                    <Rectangle x:Name="Glow7" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#FF48D0" Opacity="0.218" StrokeDashArray="1.649 122.036" StrokeDashOffset="11.544" />
                    <Rectangle x:Name="Glow8" Margin="-4" RadiusX="16" RadiusY="16" StrokeThickness="11" Stroke="#FF48D0" Opacity="0.112" StrokeDashArray="1.649 122.036" StrokeDashOffset="13.193" />
                    <Rectangle x:Name="Seg0" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#FFFFFF" Opacity="1" StrokeDashArray="4.031 298.309" StrokeDashOffset="0.000" />
                    <Rectangle x:Name="Seg1" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#DDF7FF" Opacity="1" StrokeDashArray="4.031 298.309" StrokeDashOffset="4.031" />
                    <Rectangle x:Name="Seg2" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#86E3FF" Opacity="1" StrokeDashArray="4.031 298.309" StrokeDashOffset="8.062" />
                    <Rectangle x:Name="Seg3" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#27CFFF" Opacity="1" StrokeDashArray="4.031 298.309" StrokeDashOffset="12.094" />
                    <Rectangle x:Name="Seg4" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#4F8DFF" Opacity="1" StrokeDashArray="4.031 298.309" StrokeDashOffset="16.125" />
                    <Rectangle x:Name="Seg5" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#965BFF" Opacity="0.98" StrokeDashArray="4.031 298.309" StrokeDashOffset="20.156" />
                    <Rectangle x:Name="Seg6" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#C255F0" Opacity="0.9" StrokeDashArray="4.031 298.309" StrokeDashOffset="24.187" />
                    <Rectangle x:Name="Seg7" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#FF48D0" Opacity="0.78" StrokeDashArray="4.031 298.309" StrokeDashOffset="28.218" />
                    <Rectangle x:Name="Seg8" Margin="-0.75" RadiusX="16" RadiusY="16" StrokeThickness="4.5" Stroke="#FF48D0" Opacity="0.4" StrokeDashArray="4.031 298.309" StrokeDashOffset="32.250" />
                </Grid>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="AuroraRoot">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="AuroraRoot" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.18" />
                        <DoubleAnimation Storyboard.TargetName="Glow0" Storyboard.TargetProperty="StrokeDashOffset" From="0.000" To="-123.685" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg0" Storyboard.TargetProperty="StrokeDashOffset" From="0.000" To="-302.340" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow1" Storyboard.TargetProperty="StrokeDashOffset" From="1.649" To="-122.036" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg1" Storyboard.TargetProperty="StrokeDashOffset" From="4.031" To="-298.309" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow2" Storyboard.TargetProperty="StrokeDashOffset" From="3.298" To="-120.386" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg2" Storyboard.TargetProperty="StrokeDashOffset" From="8.062" To="-294.278" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow3" Storyboard.TargetProperty="StrokeDashOffset" From="4.947" To="-118.737" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg3" Storyboard.TargetProperty="StrokeDashOffset" From="12.094" To="-290.247" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow4" Storyboard.TargetProperty="StrokeDashOffset" From="6.597" To="-117.088" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg4" Storyboard.TargetProperty="StrokeDashOffset" From="16.125" To="-286.215" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow5" Storyboard.TargetProperty="StrokeDashOffset" From="8.246" To="-115.439" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg5" Storyboard.TargetProperty="StrokeDashOffset" From="20.156" To="-282.184" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow6" Storyboard.TargetProperty="StrokeDashOffset" From="9.895" To="-113.790" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg6" Storyboard.TargetProperty="StrokeDashOffset" From="24.187" To="-278.153" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow7" Storyboard.TargetProperty="StrokeDashOffset" From="11.544" To="-112.141" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg7" Storyboard.TargetProperty="StrokeDashOffset" From="28.218" To="-274.122" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Glow8" Storyboard.TargetProperty="StrokeDashOffset" From="13.193" To="-110.492" Duration="0:0:3" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Seg8" Storyboard.TargetProperty="StrokeDashOffset" From="32.250" To="-270.091" Duration="0:0:3" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AuroraTrace" TargetType="ContentControl">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Template" Value="{StaticResource AuroraTraceTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
