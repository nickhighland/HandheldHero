                                                                   Text="{Binding SelectedGame.Playtime, Converter={StaticResource PlayTimeToStringConverter}}" />
                                                    </Border>
                                                    <Border Style="{StaticResource HeroPill}">
                                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="20" Foreground="White"
                                                                   Text="{Binding SelectedGame.LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" />
                                                    </Border>
                                                    <Border Style="{StaticResource HeroPill}">
                                                        <TextBlock FontSize="20">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                    <Setter Property="Text" Value="Not installed" />
                                                                    <Setter Property="Foreground" Value="#FF8CC8FF" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="True">
                                                                            <Setter Property="Text" Value="Installed" />
                                                                            <Setter Property="Foreground" Value="#FF7BE08F" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Style="{StaticResource HeroPill}">
                                                        <Border.Visibility>
                                                            <Binding Path="SelectedGame.Favorite" Converter="{StaticResource BooleanToVisibilityConverter}" />
                                                        </Border.Visibility>
                                                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="20" Foreground="#FFFFD451"
                                                                   Text="&#x2605; Favorite" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- carousel mode: display-only list, scaled to fit, selection always centred -->
                                        <Viewbox x:Name="CarouselHost" Stretch="Uniform" StretchDirection="DownOnly"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,0">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Carousel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Grid Width="1920" Height="500">
                                                <!-- floor glow under the selected cover -->
                                                <Ellipse Width="620" Height="120" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                         Margin="0,352,0,0" IsHitTestVisible="False">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#703FA2FF" Offset="0" />
                                                            <GradientStop Color="#223FA2FF" Offset="0.55" />
                                                            <GradientStop Color="#003FA2FF" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <ListBox x:Name="CarouselList" Width="1920" Height="500" AlternationCount="100000"
                                                         Background="Transparent" BorderThickness="0"
                                                         Focusable="False" IsTabStop="False"
                                                         ItemsSource="{Binding GamesView.CollectionView}"
                                                         SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                                                         IsSynchronizedWithCurrentItem="False"
                                                         ItemContainerStyle="{StaticResource CarouselItemStyle}">
                                                    <ListBox.Template>
                                                        <ControlTemplate TargetType="ListBox">
                                                            <!-- A Canvas gives the strip its full width (no layout clipping). -->
                                                            <Canvas Width="1920" Height="500">
                                                                <ItemsPresenter Canvas.Left="805" Canvas.Top="0" Height="500">
                                                                    <ItemsPresenter.RenderTransform>
                                                                        <TranslateTransform
                                                                            X="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 0 ? 0 : x * -310'}" />
                                                                    </ItemsPresenter.RenderTransform>
                                                                </ItemsPresenter>
                                                            </Canvas>
                                                        </ControlTemplate>
                                                    </ListBox.Template>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <GameListItem Style="{DynamicResource ListGameItemTemplate}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <!-- touch: tap left / right of the centred cover to step through the row -->
                                                <Button HorizontalAlignment="Left" Width="790" Focusable="False" IsTabStop="False"
                                                        Style="{StaticResource CarouselTapZone}"
                                                        Command="{Binding SelectPrevGameCommand}" />
                                                <Button HorizontalAlignment="Right" Width="790" Focusable="False" IsTabStop="False"
                                                        Style="{StaticResource CarouselTapZone}"
                                                        Command="{Binding SelectNextGameCommand}" />
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                            </DockPanel>

                            <TextBlock Grid.Row="1" FontSize="40"
                                       Text="{DynamicResource LOCNoGamesFound}"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ============ BOTTOM HINT BAR ============ -->
                            <Grid Grid.Row="2" Background="{DynamicResource BottomBarBackgroundBrush}"
                                  Height="84">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="5" VerticalAlignment="Top" Height="1" Background="#33FFFFFF" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!--Install-->
                                    <ButtonEx x:Name="PART_ButtonInstall"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCInstallGame}" />
                                    <!--Play-->
                                    <ButtonEx x:Name="PART_ButtonPlay"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCPlayGame}" />
                                    <!--Details-->
                                    <ButtonEx x:Name="PART_ButtonDetails"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameDetails}" />
                                    <!--Options-->
                                    <ButtonEx x:Name="PART_ButtonGameOptions"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameOptions}" />
                                    <!--Search-->
                                    <ButtonEx x:Name="PART_ButtonSearch"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCSearchLabel}" />
                                    <!--Filter-->
                                    <ButtonEx x:Name="PART_ButtonFilter"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCFilter}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" x:Name="PART_ElemSearchActive"
                                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                            Margin="0,15,0,0">
                                    <TextBlock  FontSize="18"
                                                TextAlignment="Center"
                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                Text="{DynamicResource LOCGameListSearchResults}"/>
                                    <TextBlock  Foreground="White"
                                                TextAlignment="Center"
                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" x:Name="PART_ElemExtraFilterActive"
                                           FontSize="20"
                                           VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                           TextAlignment="Center"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Text="{DynamicResource LOCGameListExtraFiltered}"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock x:Name="PART_TextProgressTooltip"
                                                   Margin="0,0,15,0" FontSize="20" VerticalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                        <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                        Height="38" Width="38" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- LB / RB switch the tabs -->
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Height="34"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <TextBlock Text="/" Style="{DynamicResource TextBlockBaseStyle}" FontSize="24"
                                               Foreground="#FF8EA0AB" Margin="6,0" VerticalAlignment="Center" />
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Height="34"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <TextBlock Text="Tabs" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="26"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <GameStatus x:Name="PART_ElemGameStatus" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="HOME">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="FAVORITES">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="FAVORITE">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="FAVOURITES">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENT">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENTLY PLAYED">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENTLY ADDED">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENT GAMES">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="MOST PLAYED">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="TOP PLAYED">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="CONTINUE PLAYING">
            <Setter Property="Tag" Value="Carousel" />
        </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
